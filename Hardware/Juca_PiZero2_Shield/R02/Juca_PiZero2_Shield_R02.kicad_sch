     (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 149.86 106.68 0) (effects (font (size 1.27 1.27)) hide))) (text "INTERLIGACAO JUCA / RASPBERRY PI ZERO 2 W" (at 25.4 22.86 0) (effects (font (size 2.0 2.0)) (justify left bottom)) (uuid "fe91cecd-b45d-527b-83a6-251897e11e97")) (text "UART: trilhas diretas em B.Cu" (at 106.68 55.88 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c81b0399-f08a-5619-b9a3-411fee1eecd6")) (text "J5-3 (TX ESP32) > JPI1-10 (RX Pi)" (at 106.68 60.96 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "9dc80bf4-a1fd-53cf-bfcc-fc6cc6cfaf43")) (text "J5-4 (RX ESP32) < JPI1-8 (TX Pi)" (at 106.68 66.04 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7bb8a510-4f3e-5c21-b2ad-153023271557")) (text "PCB com cobre apenas em B.Cu. Unico jumper: JW3, fio GND na face superior." (at 25.4 149.86 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "56ceed63-745c-575d-9ab9-2d3dcbb68108")) (text "J11-2: +5 V regulados. J11-1 (+BATT) e J11-3 (+3,3 V) ficam isolados." (at 25.4 154.94 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "21cb9024-45fd-587e-8666-0502f475d3bd")) (text "Capacidade da fonte da Juca ainda deve ser verificada com o Raspberry e a camera." (at 25.4 160.02 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "232e8981-d40c-5971-ac97-90e887c95469")) (text "GND no Raspberry usa o pino FISICO 9. Todos os outros pinos sem uso ficam NC." (at 25.4 165.1 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a9485f4c-98a7-59ba-88f6-f19a376aefd7")) (text "Soquetes inferiores: terminais longos e corpo afastado para solda no cobre inferior." (at 25.4 170.18 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ecec0dfa-7583-5366-9325-feca66ba7433")) (text "ROS, protocolo e configuracao de UART pertencem ao firmware e ao sistema do Raspberry." (at 25.4 175.26 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "345367ad-16c2-5485-a736-0ec98d325ef8"))
